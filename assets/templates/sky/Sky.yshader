#version 450

// Шейдер неба: функция sky() даёт яркость неба в нитах в направлении взгляда.
// Здесь - цвет от горизонта к зениту, диск солнца сцены с мягким краем и
// ореол вокруг него. Материал с этим шейдером ставится в поле sky узла
// Environment; поля блока Material видны в инспекторе материала (см.
// docs/architecture/materials.md).
#include <yqlora/sky.glsl>

layout(set = 2, binding = 0, std140) uniform Material {
    vec3 zenithColor;       //@ color default(0.25, 0.45, 0.85)
    vec3 horizonColor;      //@ color default(0.75, 0.8, 0.9)
    // Яркость белого в нитах.
    float luminance;        //@ default(8000)
    // Яркость ореола в его середине - доля яркости белой поверхности под солнцем.
    float sunGlow;          //@ range(0, 1) default(0.2)
    // Чем больше, тем ореол уже.
    float sunGlowFalloff;   //@ range(1, 256) default(16)
    // Яркость диска: 1 - физически, освещённость от солнца на телесный угол диска.
    float sunDiscIntensity; //@ range(0, 10) default(1)
    // Видимый угловой размер диска в градусах; 0 - как у света
    // (angularDiameter у DirectionalLight3D). Только вид: тени - от света.
    float sunDiscSize;      //@ range(0, 20) default(3.5)
    // Доля радиуса, на которой край диска плавно гаснет; 0 - резкий край.
    float sunDiscSoftness;  //@ range(0, 1) default(0.3)
} material;

const float kPi = 3.14159265358979;

vec3 sky(vec3 direction)
{
    float height = sqrt(max(direction.y, 0.0));
    vec3 color = mix(material.horizonColor, material.zenithColor, height) * material.luminance;
    if (frame.hasSun != 0) {
        float toSun = max(dot(direction, -frame.sunDirection), 0.0);
        color += frame.sunColor / kPi * material.sunGlow * pow(toSun, material.sunGlowFalloff);
#ifndef YQLORA_SKY_CAPTURE
        // Сцену солнце освещает как источник, поэтому в захвате для
        // освещения (YQLORA_SKY_CAPTURE) диска нет.
        float radius = material.sunDiscSize > 0.0 ? radians(material.sunDiscSize) * 0.5 : frame.sunAngularRadius;
        float cosRadius = cos(radius);
        if (radius > 0.0 && toSun >= cosRadius) {
            // Мягкий край: яркость уходит в ноль на внешней доле радиуса;
            // smoothstep с равными краями не определён, поэтому при 0 край резкий.
            float fromCenter = acos(min(toSun, 1.0)) / radius;
            float softness = material.sunDiscSoftness;
            float edge = softness > 0.0 ? 1.0 - smoothstep(1.0 - softness, 1.0, fromCenter) : 1.0;
            color += frame.sunColor / (2.0 * kPi * (1.0 - cosRadius)) * material.sunDiscIntensity * edge;
        }
#endif
    }

    return color;
}
