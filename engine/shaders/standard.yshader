#version 450

// Освещённый шейдер PBR, с которого начинается каждый новый материал. Каждая
// карта необязательна: без неё - текстура по умолчанию и тот же результат,
// что без карты.
#include <yqlora/standard.glsl>

layout(set = 2, binding = 0, std140) uniform Material {
    vec4 baseColor;          //@ color default(1, 1, 1, 1) tooltip("help.shader.standard.baseColor")
    vec3 emission;           //@ color default(1, 1, 1) tooltip("help.shader.standard.emission")
    // Яркость свечения в нитах: экран около 200, лампа под абажуром - тысячи.
    float emissionIntensity; //@ default(0) tooltip("help.shader.standard.emissionIntensity")
    // 1 - свечение подчиняется экспозиции камеры, как свет; 0 - на экране
    // всегда той яркости, что задана (вывески, интерфейс в мире, стиль).
    float emissionExposureWeight; //@ range(0, 1) default(1) tooltip("help.shader.standard.emissionExposureWeight")
    float metallic;          //@ range(0, 1) default(0) tooltip("help.shader.standard.metallic")
    float roughness;         //@ range(0, 1) default(0.5) tooltip("help.shader.standard.roughness")
    float occlusionStrength; //@ range(0, 1) default(1) tooltip("help.shader.standard.occlusionStrength")
    float normalScale;       //@ range(0, 2) default(1) tooltip("help.shader.standard.normalScale")
    float heightScale;       //@ range(0, 0.1) default(0) tooltip("help.shader.standard.heightScale")
    // Альфа-тест: фрагменты с альфой ниже порога не рисуются (листва,
    // решётки). 0 - выключен.
    float alphaCutoff;       //@ range(0, 1) default(0) tooltip("help.shader.standard.alphaCutoff")
} material;

// sRGB, альфа - прозрачность.
layout(set = 2, binding = 1) uniform sampler2D baseColorMap; //@ default(white) tooltip("help.shader.standard.baseColorMap")
// Линейная: R - затенение, G - шероховатость, B - металличность, как в glTF.
layout(set = 2, binding = 2) uniform sampler2D ormMap;       //@ default(white) tooltip("help.shader.standard.ormMap")
layout(set = 2, binding = 3) uniform sampler2D normalMap;    //@ default(normal) tooltip("help.shader.standard.normalMap")
layout(set = 2, binding = 4) uniform sampler2D heightMap;    //@ default(white) tooltip("help.shader.standard.heightMap")
// sRGB, множитель свечения.
layout(set = 2, binding = 5) uniform sampler2D emissionMap;  //@ default(white) tooltip("help.shader.standard.emissionMap")

#ifdef YQLORA_VERTEX
void main()
{
    standardVertex();
}
#endif

#ifdef YQLORA_FRAGMENT
void main()
{
    vec2 uv = parallaxUv(heightMap, vUv0, material.heightScale);
    vec4 base = material.baseColor * texture(baseColorMap, uv);
    if (base.a < material.alphaCutoff) {
        discard;
    }
    vec3 orm = texture(ormMap, uv).rgb;

    Surface surface = defaultSurface();
    surface.normal = normalFromMap(texture(normalMap, uv).rgb, material.normalScale);
    surface.baseColor = base.rgb;
    surface.alpha = base.a;
    surface.occlusion = mix(1.0, orm.r, material.occlusionStrength);
    surface.roughness = material.roughness * orm.g;
    surface.metallic = material.metallic * orm.b;
    surface.emission = material.emission * material.emissionIntensity * texture(emissionMap, uv).rgb;
    surface.emissionExposureWeight = material.emissionExposureWeight;
    fragColor = shade(surface);
}
#endif
